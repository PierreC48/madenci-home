# ==============================================================================
# MADENCI HOME (AILE EVI) - SUPABASE ÇEVRE DEĞİŞKENLERİ
# ==============================================================================
# 1. https://supabase.com adresinden ücretsiz bir proje oluşturun.
# 2. Project Settings > API sekmesindeki bilgileri buraya yapıştırın:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# İsteğe bağlı: Web Push bildirimleri için (üretmek için: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
